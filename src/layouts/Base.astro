---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title, description = '動きの提案用アニメーションストック' } = Astro.props;
const fullTitle = title ? `${title} | Motion Stock` : 'Motion Stock | Puchigraphics';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Noto+Sans+JP:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href="/" class="site-header__logo en">Motion Stock</a>
        <span class="site-header__sub en">Puchigraphics</span>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="wrap en">© Puchigraphics</div></footer>
  </body>
</html>
<style>
  .site-header { border-bottom: 1px solid var(--color-line); }
  .site-header__inner { display: flex; align-items: baseline; justify-content: space-between; height: 64px; align-items: center; }
  .site-header__logo { font-weight: 500; font-size: 16px; }
  .site-header__sub { color: var(--color-text-sub); font-size: 12px; }
  .site-footer { margin-top: var(--space-8); padding-block: var(--space-6); border-top: 1px solid var(--color-line); color: var(--color-text-sub); font-size: 12px; }
</style>
